# Server port (Render injects PORT automatically)
PORT=3001

# Required in production (Render generates this automatically via render.yaml)
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection string (optional locally; SQLite in ./data/offerly-dev.db is used if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/offerly

# Optional SMTP configuration for real password-reset emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Offerly <you@example.com>"

# Optional seeded demo/evaluation accounts (defaults are shown)
# DEMO_ADMIN_EMAIL=admin@offerly.in
# DEMO_ADMIN_PASSWORD=Admin@123
# DEMO_STUDENT_EMAIL=student@offerly.in
# DEMO_STUDENT_PASSWORD=Student@123
